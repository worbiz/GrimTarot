<!-- 4. Datenspeicherung: Vollständiger Ausschluss von automatischen Backups und USB/ADB Extraction -->
<data-extraction-rules>
    <cloud-backup>
        <exclude path="." />
    </cloud-backup>
    <device-transfer>
        <exclude path="." />
    </device-transfer>
</data-extraction-rules>
