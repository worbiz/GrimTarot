<?xml version="1.0" encoding="utf-8"?>
<!-- 3. Netzwerkschicht: TLS 1.3 erzwingen, Cleartext global verbieten -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
